    {
      "id": "nacl-no-reply",
      "story": "A network ACL was added to the public subnet \"for safety\". Requests arrive, but customers never get an answer.",
      "probe": {
        "from": "internet:198.51.100.7",
        "to": "alb",
        "port": 443
      },
      "expect": {
        "code": "nacl-return-denied",
        "where": "nacl-public"
      },
      "network": {
        "name": "daftar",
        "cidr": "10.20.0.0/16",
        "internetGateway": true,
        "natGateways": {
          "nat-a": {
            "subnet": "public-a"
          }
        },
        "subnets": {
          "app-a": {
            "cidr": "10.20.0.0/22",
            "routeTable": "rt-app"
          },
          "app-b": {
            "cidr": "10.20.4.0/22",
            "routeTable": "rt-app"
          },
          "public-a": {
            "cidr": "10.20.8.0/24",
            "routeTable": "rt-public",
            "nacl": "nacl-public"
          },
          "public-b": {
            "cidr": "10.20.9.0/24",
            "routeTable": "rt-public"
          },
          "data-a": {
            "cidr": "10.20.10.0/26",
            "routeTable": "rt-data"
          },
          "data-b": {
            "cidr": "10.20.10.64/26",
            "routeTable": "rt-data"
          }
        },
        "routeTables": {
          "rt-public": [
            {
              "destination": "10.20.0.0/16",
              "target": "local"
            },
            {
              "destination": "0.0.0.0/0",
              "target": "igw"
            }
          ],
          "rt-app": [
            {
              "destination": "10.20.0.0/16",
              "target": "local"
            },
            {
              "destination": "0.0.0.0/0",
              "target": "nat:nat-a"
            }
          ],
          "rt-data": [
            {
              "destination": "10.20.0.0/16",
              "target": "local"
            }
          ]
        },
        "securityGroups": {
          "sg-alb": {
            "ingress": [
              {
                "protocol": "tcp",
                "from": 443,
                "to": 443,
                "peer": "0.0.0.0/0"
              }
            ],
            "egress": [
              {
                "protocol": "tcp",
                "from": 8080,
                "to": 8080,
                "peer": "sg-app"
              }
            ]
          },
          "sg-app": {
            "ingress": [
              {
                "protocol": "tcp",
                "from": 8080,
                "to": 8080,
                "peer": "sg-alb"
              }
            ],
            "egress": [
              {
                "protocol": "tcp",
                "from": 5432,
                "to": 5432,
                "peer": "sg-db"
              },
              {
                "protocol": "tcp",
                "from": 443,
                "to": 443,
                "peer": "0.0.0.0/0"
              }
            ]
          },
          "sg-db": {
            "ingress": [
              {
                "protocol": "tcp",
                "from": 5432,
                "to": 5432,
                "peer": "sg-app"
              }
            ],
            "egress": []
          }
        },
        "nacls": {
          "nacl-public": {
            "inbound": [
              {
                "rule": 100,
                "action": "allow",
                "protocol": "tcp",
                "from": 443,
                "to": 443,
                "cidr": "0.0.0.0/0"
              },
              {
                "rule": 110,
                "action": "allow",
                "protocol": "tcp",
                "from": 1024,
                "to": 65535,
                "cidr": "0.0.0.0/0"
              }
            ],
            "outbound": [
              {
                "rule": 100,
                "action": "allow",
                "protocol": "tcp",
                "from": 80,
