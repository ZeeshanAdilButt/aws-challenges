{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ReadJobs", "Effect": "Allow", "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"], "Resource": "arn:aws:sqs:us-east-1:123456789012:daftar-jobs" },
    { "Sid": "ReadWriteExports", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"], "Resource": "arn:aws:s3:::daftar-capstone-notes/exports/*" },
    { "Sid": "WriteLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/daftar-worker:*" }
  ]
}
